{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Firmware Build",
            "type": "shell",
            "command": "make",
            "args": [
                "merge"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
		{
            "label": "Run Firmware Flash",
            "type": "shell",
            "command": "make",
            "args": [
                "flash"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
		{
            "label": "Run Full Flash",
            "type": "shell",
            "command": "make",
            "args": [
                "flash-full"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}